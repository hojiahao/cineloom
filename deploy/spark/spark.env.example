# Copy to deploy/spark/spark.env (git-ignored). Never commit real keys.
SPARK_MODEL_DIR=/home/orion/models
VLLM_TAG=v0.27.1
# Match the NGC PyTorch tag to your DGX OS release (must be an arm64 build).
PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:25.10-py3

# Fractions of TOTAL unified memory. Keep the sum <= ~0.45 so diffusion still fits.
NEMOTRON_GPU_MEM=0.25
NEMOTRON_MAX_LEN=65536
STEPVL_GPU_MEM=0.20
STEPVL_MAX_LEN=32768
